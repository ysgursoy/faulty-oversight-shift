{
  "$defs": {
    "Attempt": {
      "additionalProperties": false,
      "description": "One model call for a logical query; raw output always kept.",
      "properties": {
        "attempt_class": {
          "enum": [
            "valid",
            "refusal",
            "format"
          ],
          "title": "Attempt Class",
          "type": "string"
        },
        "attempt_id": {
          "minLength": 1,
          "title": "Attempt Id",
          "type": "string"
        },
        "extra_text": {
          "default": "",
          "title": "Extra Text",
          "type": "string"
        },
        "raw_output": {
          "title": "Raw Output",
          "type": "string"
        },
        "stop_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stop Reason"
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        }
      },
      "required": [
        "attempt_id",
        "raw_output",
        "attempt_class",
        "usage"
      ],
      "title": "Attempt",
      "type": "object"
    },
    "CaseType": {
      "enum": [
        "A",
        "near_measurement",
        "near_weight",
        "U"
      ],
      "title": "CaseType",
      "type": "string"
    },
    "DatasetSplit": {
      "enum": [
        "development",
        "evaluation"
      ],
      "title": "DatasetSplit",
      "type": "string"
    },
    "Frame": {
      "enum": [
        "neutral",
        "agriculture",
        "human"
      ],
      "title": "Frame",
      "type": "string"
    },
    "GenerationSettings": {
      "additionalProperties": false,
      "properties": {
        "max_tokens": {
          "exclusiveMinimum": 0,
          "title": "Max Tokens",
          "type": "integer"
        },
        "temperature": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature"
        },
        "thinking": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Thinking"
        },
        "top_p": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top P"
        }
      },
      "required": [
        "max_tokens"
      ],
      "title": "GenerationSettings",
      "type": "object"
    },
    "InvalidClass": {
      "enum": [
        "refusal",
        "format"
      ],
      "title": "InvalidClass",
      "type": "string"
    },
    "Usage": {
      "additionalProperties": false,
      "properties": {
        "cache_creation_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Creation Input Tokens",
          "type": "integer"
        },
        "cache_read_input_tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Read Input Tokens",
          "type": "integer"
        },
        "input_tokens": {
          "minimum": 0,
          "title": "Input Tokens",
          "type": "integer"
        },
        "output_tokens": {
          "minimum": 0,
          "title": "Output Tokens",
          "type": "integer"
        }
      },
      "required": [
        "input_tokens",
        "output_tokens"
      ],
      "title": "Usage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One single-turn protocol check: no feedback, no evaluator mentioned.",
  "properties": {
    "attempts": {
      "items": {
        "$ref": "#/$defs/Attempt"
      },
      "maxItems": 2,
      "minItems": 1,
      "title": "Attempts",
      "type": "array"
    },
    "case_id": {
      "minLength": 1,
      "title": "Case Id",
      "type": "string"
    },
    "case_type": {
      "$ref": "#/$defs/CaseType"
    },
    "dataset_split": {
      "$ref": "#/$defs/DatasetSplit"
    },
    "frame": {
      "$ref": "#/$defs/Frame"
    },
    "generation_settings": {
      "$ref": "#/$defs/GenerationSettings"
    },
    "invalid_class": {
      "anyOf": [
        {
          "$ref": "#/$defs/InvalidClass"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "logical_query_id": {
      "minLength": 1,
      "title": "Logical Query Id",
      "type": "string"
    },
    "prompt_version": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Prompt Version",
      "type": "string"
    },
    "r_star": {
      "title": "R Star",
      "type": "integer"
    },
    "record_type": {
      "const": "precheck",
      "default": "precheck",
      "title": "Record Type",
      "type": "string"
    },
    "requested_model": {
      "minLength": 1,
      "title": "Requested Model",
      "type": "string"
    },
    "returned_model": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Returned Model"
    },
    "run_id": {
      "minLength": 1,
      "title": "Run Id",
      "type": "string"
    },
    "wording": {
      "enum": [
        1,
        2
      ],
      "title": "Wording",
      "type": "integer"
    },
    "y": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "title": "Y"
    }
  },
  "required": [
    "dataset_split",
    "frame",
    "wording",
    "case_id",
    "case_type",
    "r_star",
    "attempts",
    "y",
    "requested_model",
    "generation_settings",
    "prompt_version",
    "run_id",
    "logical_query_id"
  ],
  "title": "PrecheckRecord",
  "type": "object"
}
